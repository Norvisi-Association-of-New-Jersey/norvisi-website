---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';

import president from '~/assets/images/IMG-matilda.jpg';
import vice_president from '~/assets/images/IMG-seshime.jpg';
import financial_secretary from '~/assets/images/IMG-fidelia-a.jpg';
import assistant_organizing_secretary from '~/assets/images/IMG-fidelia-k.jpg';
import organizing_secretary from '~/assets/images/IMG-stephen.jpg';
import no_image from '~/assets/images/no-image.png';

const metadata = {
  title: 'Executives',
};
---

<Layout metadata={metadata}>
  <div class="p-12">
    <h1 class="text-5xl font-bold text-center my-8">Our Executives</h1>
    <div class="mx-auto container max-w-screen-lg grid grid-cols-3 gap-12">
      <a>
        <Image
          src={president}
          alt="Matilda Akaho"
          height={720}
          quality="mid"
          format="avif"
          class:list={['rounded-lg transition-all', 'group-hover:shadow-lg group-hover:opacity-90']}
        />
        <div class="mt-4 text-center text-neutral-700">
          <strong class="font-bold text-2xl text-orange-500">Matilda Akaho</strong>
          <p class="text-xl text-gray-500">President</p>
        </div>
      </a>
      <a>
        <Image
          src={vice_president}
          alt="Seshime Kodzo Dovlo"
          height={720}
          quality="mid"
          format="avif"
          class:list={['rounded-lg transition-all', 'group-hover:shadow-lg group-hover:opacity-90']}
        />
        <div class="mt-4 text-center text-neutral-700">
          <strong class="font-bold text-2xl text-orange-500">Seshime Kodzo Dovlo</strong>
          <p class="text-xl text-gray-500">Vice President</p>
        </div>
      </a>
      <a>
        <Image
          src={no_image}
          alt="Rosemary Antwi"
          height={720}
          quality="mid"
          format="avif"
          class:list={['rounded-lg transition-all', 'group-hover:shadow-lg group-hover:opacity-90']}
        />
        <div class="mt-4 text-center text-neutral-700">
          <strong class="font-bold text-2xl text-orange-500">Rosemary Antwi</strong>
          <p class="text-xl text-gray-500">Secretary</p>
        </div>
      </a>
      <a>
        <Image
          src={no_image}
          alt="Vicentia Akpene Ackuaku-Dzandu"
          height={720}
          quality="mid"
          format="avif"
          class:list={['rounded-lg transition-all', 'group-hover:shadow-lg group-hover:opacity-90']}
        />
        <div class="mt-4 text-center text-neutral-700">
          <strong class="font-bold text-2xl text-orange-500">Vicentia Akpene Ackuaku-Dzandu</strong>
          <p class="text-xl text-gray-500">Assistant Secretary</p>
        </div>
      </a>
      <a>
        <Image
          src={financial_secretary}
          alt="Felicia Adadevoh"
          height={720}
          quality="mid"
          format="avif"
          class:list={['rounded-lg transition-all', 'group-hover:shadow-lg group-hover:opacity-90']}
        />
        <div class="mt-4 text-center text-neutral-700">
          <strong class="font-bold text-2xl text-orange-500">Felicia Adadevoh</strong>
          <p class="text-xl text-gray-500">Financial Secretary</p>
        </div>
      </a>
      <a>
        <Image
          src={no_image}
          alt="Rita Tamakloe"
          height={720}
          quality="mid"
          format="avif"
          class:list={['rounded-lg transition-all', 'group-hover:shadow-lg group-hover:opacity-90']}
        />
        <div class="mt-4 text-center text-neutral-700">
          <strong class="font-bold text-2xl text-orange-500">Rita Tamakloe</strong>
          <p class="text-xl text-gray-500">Treasurer</p>
        </div>
      </a>
      <a>
        <Image
          src={organizing_secretary}
          alt="Stephen Awunyo"
          height={720}
          quality="mid"
          format="avif"
          class:list={['rounded-lg transition-all', 'group-hover:shadow-lg group-hover:opacity-90']}
        />
        <div class="mt-4 text-center text-neutral-700">
          <strong class="font-bold text-2xl text-orange-500">Stephen Awunyo</strong>
          <p class="text-xl text-gray-500">Organizing Secretary</p>
        </div>
      </a>
      <a>
        <Image
          src={assistant_organizing_secretary}
          alt="Felicia Nunana Kukah"
          height={720}
          quality="mid"
          format="avif"
          class:list={['rounded-lg transition-all', 'group-hover:shadow-lg group-hover:opacity-90']}
        />
        <div class="mt-4 text-center text-neutral-700">
          <strong class="font-bold text-2xl text-orange-500">Felicia Nunana Kukah</strong>
          <p class="text-xl text-gray-500">Assistant Organizing Secretary</p>
        </div>
      </a>
    </div>
  </div>

